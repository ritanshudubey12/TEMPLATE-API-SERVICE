NODE_ENV=development
PORT=4018
LOG_LEVEL=info

# --- PostgreSQL (docker-compose reads the POSTGRES_* values) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=template_service
POSTGRES_PORT=5432
# Used when the API runs on the host. Inside docker-compose it is overridden to host "db".
DATABASE_URL=postgresql://app:<POSTGRES_PASSWORD>@localhost:5432/template_service
DB_POOL_MAX=10

# --- JWT verification ---
JWT_ISSUER=http://localhost:4018/dev
JWT_AUDIENCE=website-builder-api
# Production: the Identity Provider's JWKS URL. Leave empty in local dev when DEV_AUTH_ENABLED=true.
JWT_JWKS_URL=
# LOCAL ONLY: exposes POST /dev/token and /dev/jwks.json so you can mint test tokens. Refused when NODE_ENV=production.
DEV_AUTH_ENABLED=true
# REQUIRED. Signs short-lived preview tokens (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PREVIEW_TOKEN_SECRET=

# --- Downstream services ---
# mock = in-process stand-ins for Website/Page/Theme/Media/Identity (local dev + Postman). http = call the real services.
INTEGRATIONS_MODE=mock
IDENTITY_API_URL=
WEBSITE_API_URL=
PAGE_API_URL=
THEME_API_URL=
MEDIA_API_URL=
# Used for background apply jobs when no caller token is available (http mode)
INTEGRATIONS_SERVICE_TOKEN=

# --- Limits ---
TEMPLATE_MAX_DOCUMENT_BYTES=2097152
TEMPLATE_APPLY_JOB_TIMEOUT_MS=120000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
CORS_ALLOWED_ORIGINS=

# --- Outbox ---
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_WEBHOOK_URL=
